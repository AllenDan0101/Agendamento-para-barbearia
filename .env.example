# Copie para .env e ajuste se precisar. O arquivo .env não vai para o Git.
PORT=3333
NODE_ENV=development
JWT_SECRET=troque-este-segredo-antes-de-publicar
JWT_EXPIRES_IN=8h
BCRYPT_COST=10

# sqlite (padrão) ou postgres
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/barbearia.db
DATABASE_URL=postgres://barbearia:barbearia@localhost:5432/barbearia

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# false para não popular o banco vazio na subida da API
SEED=true
